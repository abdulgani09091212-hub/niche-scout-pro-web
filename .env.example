# Niche Scout Pro - Vercel Environment Variables
# -------------------------------------------------------------
# Optional: Secure your Remote MCP Server with a custom private key
# When set, all remote LLM calls (Claude, Cursor, Agents) must pass:
# Headers: { "x-api-key": "YOUR_SECRET_KEY" }
MCP_API_KEY=scout_live_your_secret_key_here

# Optional: Upstash Redis for multi-region rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
